{
  "$schema": "https://raw.githubusercontent.com/blankeos/gittydocs/main/gittydocs.schema.json",
  "theme": {
    "preset": "ember",
  },
  "site": {
    "name": "crabcode",
    "repo": {
      "owner": "blankeos",
      "name": "crabcode",
      "ref": "main",
      "docsPath": "_docs",
    },
  },
  "nav": [
    {
      "label": "Docs",
      "items": [
        { "label": "Overview", "path": "/" },
        { "label": "Quickstart", "path": "/quickstart" },
        { "label": "Configuration", "path": "/config" },
      ],
    },
  ],
}
