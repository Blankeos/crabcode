{
  "$schema": "crabcode.schema.json",
  // Opt into Meridian without selecting a default model.
  // Crabcode starts the installed local meridian in the background when needed.
  // No key needed for an unprotected local endpoint; upstream login is separate.
  "provider": {
    "meridian": {
      "options": { "baseURL": "http://127.0.0.1:3456/v1" },
    },
  },
  // Crabcode theme id (see src/generated_themes/carbonfox.json)
  // "theme": "vercel",
  "notifications": {
    "complete": {
      "terminal": "auto",
      "soundEnabled": true,
      "desktop": true,
      "soundFile": "/Users/carlo/Desktop/Projects/crabcode/sounds/complete.wav",
    },
    "question": {
      "soundEnabled": true,
      "soundFile": "/Users/carlo/Desktop/Projects/crabcode/sounds/question.mp3",
    },
    "permission": {
      "soundEnabled": true,
      "soundFile": "/Users/carlo/Desktop/Projects/crabcode/sounds/question.mp3",
    },
    "error": {
      "soundEnabled": true,
      "soundFile": "/Users/carlo/Desktop/Projects/crabcode/sounds/error.mp3",
    },
  },
}
