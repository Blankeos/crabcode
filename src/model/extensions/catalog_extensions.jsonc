// Model catalog extensions, applied on top of models.dev (parsed as JSONC).
// Unknown model ids are added; existing ids are deep-merged with these fields winning.
{
  "xai": {
    "id": "xai",
    "name": "xAI",
    "models": {
      "grok-composer-2.5-fast": {
        "id": "grok-composer-2.5-fast",
        "name": "Composer 2.5",
        "family": "grok-build",
        "attachment": false,
        "reasoning": false,
        "tool_call": true,
        "structured_output": true,
        "temperature": true,
        "release_date": "2026-06-01",
        "last_updated": "2026-06-05",
        "modalities": {
          "input": ["text", "pdf"],
          "output": ["text"]
        },
        "open_weights": false,
        "limit": {
          "context": 256000,
          "output": 256000
        },
        "cost": {
          "input": 0.5,
          "output": 2.5,
          "cache_read": 0.2
        }
      }
    }
  },

  // crof.ai/pricing marks these as vision models, models.dev doesn't. Checked 2026-08-08. Remove after https://github.com/anomalyco/models.dev/pull/4363/changes is merged
  "crof": {
    "models": {
      "greg-1-mini": {
        "attachment": true,
        "modalities": {
          "input": ["text", "image"]
        }
      },
      "kimi-k2.5-lightning": {
        // modalities already include "image"; only the attachment flag is wrong.
        "attachment": true
      }
    }
  }
}
